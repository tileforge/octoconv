ARG VENV_STAGE=venv

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS venv
ARG OCP_VERSION=7.9.3.1.1
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
COPY scripts/cad-measure/requirements-*.txt /req/
RUN /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: --require-hashes \
      -r /req/requirements-common.txt \
 && /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: --no-deps --require-hashes \
      -r /req/requirements-ocp-${OCP_VERSION}.txt \
 && /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: --no-deps --require-hashes \
      -r /req/requirements-vtk.txt

FROM venv AS venv-pruned
COPY scripts/cad-measure/vtk_keeplist.py scripts/cad-measure/vtk-keeplist.txt /tmp/keeplist/
RUN /opt/venv/bin/python -I -B /tmp/keeplist/vtk_keeplist.py prune \
      --keeplist /tmp/keeplist/vtk-keeplist.txt --site /opt/venv/lib/python3.11/site-packages \
 && rm -rf /tmp/keeplist

FROM ${VENV_STAGE} AS venv-selected

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 libosmesa6 libgl1 libx11-6 librsvg2-bin fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
COPY --from=venv-selected /opt/venv /opt/venv
COPY scripts/cad-measure/*.py /opt/cad-measure/
RUN /opt/venv/bin/python -m compileall -q /opt/cad-measure
RUN /opt/venv/bin/python -I -B -c "import OCP, ezdxf, vtkmodules.vtkCommonCore, vtkmodules.vtkFiltersCore, vtkmodules.vtkIOGeometry, vtkmodules.vtkIOImage, vtkmodules.vtkRenderingCore, vtkmodules.vtkRenderingOpenGL2"
USER nobody
