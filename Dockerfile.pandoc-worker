# Build stage
FROM golang:1.27.3-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/pandoc-worker ./cmd/pandoc-worker

# Runtime stage: NO engine source-build stage and NO data-bake here (the
# deliberate simplification over Dockerfile.ocr-worker/Dockerfile.audio-
# worker/Dockerfile.av-worker) -- pandoc's GitHub releases ship a ready,
# fully-static `pandoc` binary per arch, so this stage only needs to
# download + SHA-256-verify + extract that one file. `curl` is required at
# runtime-build-time to fetch the pinned tarball; ca-certificates lets curl
# validate the GitHub TLS chain. Deliberately EXCLUDED: poppler-utils,
# tesseract, and above all texlive/latex/tectonic/wkhtmltopdf/weasyprint --
# pandoc's ->pdf writer is not in the allowlist (pandocPairTable,
# internal/convert/pandoc.go), so a TeX toolchain would be pure dead weight
# and is deliberately never installed (D-02, 49-CONTEXT.md).
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
 && rm -rf /var/lib/apt/lists/*

# Pinned official static-release pandoc 3.10.1 (D-02, resolved live via
# https://api.github.com/repos/jgm/pandoc/releases/tags/3.10.1 on 2026-07-31)
# -- NOT apt (Debian bookworm ships a stale packaged pandoc), NOT a GHC
# source-build (pandoc's own build is a multi-hour GHC/Haskell toolchain
# affair the release tarball exists specifically to avoid). Both linux-amd64
# and linux-arm64 tarballs are fully-static per pandoc's release notes, and
# both SHA-256 hashes below were verified live by downloading each tarball
# and running `sha256sum` against it on 2026-07-31 -- never trust an
# unverified published checksum page alone. ARG TARGETARCH is populated by
# BuildKit/buildx automatically (no --build-arg needed) and lets one
# Dockerfile build natively for both CI/prod (amd64) and local measurement
# (arm64) with no qemu emulation.
ARG PANDOC_VERSION=3.10.1
ARG TARGETARCH
ARG PANDOC_SHA256_AMD64=72948bf5784f560d5ad1876709daca27e0667f262da727bb33f77b58e52df2f5
ARG PANDOC_SHA256_ARM64=cd3963da375793a4804c65ae538b4f7b9c23f87cac7f6c74a1cf5e2fff7e8d59
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) PANDOC_ARCH=amd64; PANDOC_SHA256="${PANDOC_SHA256_AMD64}" ;; \
      arm64) PANDOC_ARCH=arm64; PANDOC_SHA256="${PANDOC_SHA256_ARM64}" ;; \
      *) echo "FATAL: unsupported TARGETARCH '${TARGETARCH}' -- only amd64/arm64 are pinned" >&2; exit 1 ;; \
    esac; \
    TARBALL="pandoc-${PANDOC_VERSION}-linux-${PANDOC_ARCH}.tar.gz"; \
    curl -fL --retry 5 --retry-delay 5 -o "/tmp/${TARBALL}" \
      "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/${TARBALL}"; \
    echo "${PANDOC_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    mkdir -p /tmp/pandoc-extract; \
    tar -xzf "/tmp/${TARBALL}" -C /tmp/pandoc-extract "pandoc-${PANDOC_VERSION}/bin/pandoc"; \
    install -m 0755 "/tmp/pandoc-extract/pandoc-${PANDOC_VERSION}/bin/pandoc" /usr/local/bin/pandoc; \
    rm -rf "/tmp/${TARBALL}" /tmp/pandoc-extract

COPY --from=build /out/pandoc-worker /usr/local/bin/pandoc-worker

# Belt-and-suspenders runtime version assertion (mirrors Dockerfile.ocr-
# worker's/Dockerfile.av-worker's own `--version | grep` guard): proves the
# extracted binary that lands in this stage actually reports the pinned
# major version, catching a mis-extracted/wrong-arch binary that the SHA
# check alone would not (a corrupted-but-matching pin is not the failure
# mode this guards -- a WRONG arch's binary silently exec'ing under qemu
# emulation, or a stale layer-cache hit, is).
RUN /usr/local/bin/pandoc --version | grep -q "pandoc 3\." \
 || { echo "FATAL: runtime pandoc does not report a pandoc 3.x version" >&2; exit 1; }

# Run unprivileged: the worker shells out to untrusted-input pandoc
# conversions on client-supplied markup (mirrors every other engine-worker
# image's USER nobody posture).
USER nobody

# pandoc runs as a single synchronous subprocess per job (no forking daemon
# like LibreOffice's oosplash->soffice.bin), so -- matching Dockerfile.
# worker's/Dockerfile.ocr-worker's own documented rationale -- there is no
# orphaned-grandchild risk here and no init/reaper is needed as PID 1.
ENTRYPOINT ["/usr/local/bin/pandoc-worker"]
