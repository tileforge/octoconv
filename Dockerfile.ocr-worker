# Build stage
FROM golang:1.27.4-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/ocr-worker ./cmd/ocr-worker

# Engine build stage: mirrors Dockerfile.av-worker's ffmpeg-build /
# Dockerfile.audio-worker's whisper-build SHAPE -- a separate, throwaway
# build stage whose only job is producing compiled artifacts the runtime
# stage COPYs, never rebuilding the toolchain there. Builds Leptonica FIRST
# (Tesseract's own image-I/O + adaptive-binarization dependency, STACK.md)
# THEN Tesseract against it, both from pinned source (D-01: reproducible,
# avoids Debian bookworm's stale packaged tesseract-ocr 5.3.0).
FROM debian:bookworm-slim AS tess-build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential autoconf automake libtool pkg-config \
      git ca-certificates curl \
      libpng-dev libjpeg62-turbo-dev libtiff-dev libwebp-dev libarchive-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

# --- Leptonica (Tesseract's own image-I/O + Otsu-binarization dependency) ---
# Pin by TAG *and* assert the resolved COMMIT (D-01/T-45-SC, mirrors
# Dockerfile.av-worker's ffmpeg n8.1.2 rationale): git tags can be
# force-pushed, silently changing every compiled byte. 1.87.0 is a
# LIGHTWEIGHT tag (git ls-remote --tags returns a single line, no "^{}"
# peeled-commit line -- unlike ffmpeg's ANNOTATED n8.1.2 tag) so the tag
# hash returned by `git ls-remote` already IS the commit `git checkout
# 1.87.0` resolves to; the rev-parse guard below still fails the build loud
# if that ever changes. Resolved live via `git ls-remote --tags
# https://github.com/DanBloomberg/leptonica.git` on 2026-07-26.
ARG LEPTONICA_TAG=1.87.0
ARG LEPTONICA_COMMIT=13275a278eb55b5746e33f95fbf5a2c8f604b3ab
RUN git clone --depth 1 --branch "${LEPTONICA_TAG}" \
      https://github.com/DanBloomberg/leptonica.git /leptonica \
 && git -C /leptonica checkout --detach "${LEPTONICA_COMMIT}" \
 && [ "$(git -C /leptonica rev-parse HEAD)" = "${LEPTONICA_COMMIT}" ]
WORKDIR /leptonica
RUN ./autogen.sh \
 && ./configure \
 && make -j"$(nproc)" \
 && make install \
 && ldconfig
# Belt-and-suspenders build-time version assertion (mirrors
# Dockerfile.av-worker's `ffmpeg -version | grep` guard): the rev-parse
# guard above only proves the SOURCE was pinned correctly -- this proves the
# COMPILED library that lands in the runtime stage actually reports 1.87.0
# via its own installed pkg-config metadata, catching a configure/build
# misconfiguration that silently picks up a different Leptonica.
RUN pkg-config --modversion lept | grep -qx "1.87.0" \
 || { echo "FATAL: built leptonica does not report version 1.87.0" >&2; exit 1; }

# --- Tesseract 5.5.3 ---
# Pin by TAG *and* assert the resolved COMMIT (D-01/T-45-SC). 5.5.3 is an
# ANNOTATED tag (git ls-remote --tags returns TWO lines: the tag-object hash
# and a "5.5.3^{}" PEELED COMMIT hash, the same caveat
# Dockerfile.av-worker's n8.1.2 pin documents) -- TESSERACT_COMMIT below is
# the PEELED COMMIT, matching what `git checkout 5.5.3` + `git rev-parse
# HEAD` actually resolves to. Resolved live via `git ls-remote --tags
# https://github.com/tesseract-ocr/tesseract.git` on 2026-07-26.
ARG TESSERACT_TAG=5.5.3
ARG TESSERACT_COMMIT=db0ec62f81b0737fbbe184d8fea40af5738f8eef
RUN git clone --depth 1 --branch "${TESSERACT_TAG}" \
      https://github.com/tesseract-ocr/tesseract.git /tesseract \
 && git -C /tesseract checkout --detach "${TESSERACT_COMMIT}" \
 && [ "$(git -C /tesseract rev-parse HEAD)" = "${TESSERACT_COMMIT}" ]
WORKDIR /tesseract
RUN ./autogen.sh \
 && ./configure \
 && make -j"$(nproc)" \
 && make install \
 && ldconfig
# Belt-and-suspenders runtime version-string assertion (mirrors
# Dockerfile.av-worker's ffmpeg version/CVE guard): the rev-parse guard
# above only proves the SOURCE was pinned correctly -- this proves the
# COMPILED BINARY that lands in the runtime stage actually reports 5.5.3,
# catching a configure/build misconfiguration that silently links a
# different tesseract found on PATH.
RUN /usr/local/bin/tesseract --version | grep -q "tesseract 5\.5\.3" \
 || { echo "FATAL: built tesseract does not report version 5.5.3" >&2; exit 1; }

# --- tessdata_fast bake: SHA-256-pinned eng+rus ONLY (PITFALLS.md Pitfall 4
# -- never the full upstream tessdata/tessdata_best set: language-pack bloat
# balloons the image and defeats KEDA scale-from-zero cold-start economics).
# Mirrors Dockerfile.audio-worker's ggml-base.bin bake: curl --fail --retry,
# then a fail-closed `sha256sum -c -` BEFORE the file is ever COPYd into the
# runtime stage. Pinned to a fixed tessdata_fast commit SHA (never the
# mutable `main` branch pointer), resolved live via `git ls-remote
# https://github.com/tesseract-ocr/tessdata_fast.git HEAD` on 2026-07-26;
# both file hashes verified live by downloading and sha256sum-ing them
# against that exact commit.
ARG TESSDATA_FAST_COMMIT=87416418657359cb625c412a48b6e1d6d41c29bd
RUN mkdir -p /tessdata \
 && curl -fL --retry 5 --retry-delay 5 -o /tessdata/eng.traineddata \
      "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/${TESSDATA_FAST_COMMIT}/eng.traineddata" \
 && echo "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2  /tessdata/eng.traineddata" | sha256sum -c - \
 && curl -fL --retry 5 --retry-delay 5 -o /tessdata/rus.traineddata \
      "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/${TESSDATA_FAST_COMMIT}/rus.traineddata" \
 && echo "e16e5e036cce1d9ec2b00063cf8b54472625b9e14d893a169e2b0dedeb4df225  /tessdata/rus.traineddata" | sha256sum -c -

# Runtime stage: ocr engine needs tesseract + leptonica (self-built, COPYd
# below -- neither ships as a bookworm apt package new enough to satisfy
# D-01's 5.5.x pin) + poppler-utils (pdftoppm/pdfinfo/pdftotext, apt --
# ocrguards.go's/ocrpdf.go's deps, STACK.md: a stable, widely-packaged dep,
# same posture as av's apt-installed codec libs) + the runtime shared libs
# Tesseract/Leptonica dynamically link against.
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      poppler-utils \
      libpng16-16 libjpeg62-turbo libtiff6 libwebp7 libwebpmux3 libarchive13 zlib1g \
      libgomp1 libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=tess-build /usr/local/bin/tesseract /usr/local/bin/tesseract
COPY --from=tess-build /usr/local/lib/libtesseract.so* /usr/local/lib/
# Leptonica 1.87.0 installs its shared library as libleptonica.so.6 (NOT the
# historical liblept.so name) -- verified live via readelf -d against this
# stage's own compiled tesseract/libtesseract.so.5 NEEDED entries.
COPY --from=tess-build /usr/local/lib/libleptonica.so* /usr/local/lib/
# Leptonica/Tesseract's self-built shared libs land in /usr/local/lib with no
# RPATH set (same discovery gap Dockerfile.audio-worker's libwhisper.so hit)
# -- register them in ld's default search path or the tesseract binary
# fails to start with "error while loading shared libraries".
RUN ldconfig
# tessdata_fast bake: ONLY the two SHA-256-verified eng+rus files (never a
# directory glob of the whole tess-build tessdata tree -- Pitfall 4).
ENV TESSDATA_PREFIX=/usr/local/share/tessdata
RUN mkdir -p "${TESSDATA_PREFIX}"
COPY --from=tess-build /tessdata/eng.traineddata "${TESSDATA_PREFIX}/eng.traineddata"
COPY --from=tess-build /tessdata/rus.traineddata "${TESSDATA_PREFIX}/rus.traineddata"
# tesseract's OUTPUT-FORMAT config files (configs/hocr, configs/alto,
# configs/tsv, configs/txt, ...) + tessconfigs/ ship with the ENGINE via
# `make install`, NOT with the language packs -- they are tiny plain-text
# parameter files, not language data, so Pitfall 4 (language-pack bloat,
# which is about multi-MB .traineddata files) does not apply to them.
# Without them `tesseract <img> <out> hocr` / `... alto` fail with
# "read_params_file: Can't open hocr" and produce NO output file -- while an
# image->txt job still succeeds (txt is tesseract's built-in default output,
# needing no config file), which is exactly why ->txt worked but ->hocr
# silently produced nothing before this COPY was added.
COPY --from=tess-build /usr/local/share/tessdata/configs "${TESSDATA_PREFIX}/configs"
COPY --from=tess-build /usr/local/share/tessdata/tessconfigs "${TESSDATA_PREFIX}/tessconfigs"
COPY --from=build /out/ocr-worker /usr/local/bin/ocr-worker
# Belt-and-suspenders runtime assertions (mirrors Dockerfile.av-worker's
# ffmpeg version grep): prove the COPYd binary in THIS stage reports the
# pinned version and that the baked tessdata set is exactly eng+rus (no
# stray language files ever leaked in from the build stage).
RUN /usr/local/bin/tesseract --version | grep -q "tesseract 5\.5\.3" \
 || { echo "FATAL: runtime tesseract does not report version 5.5.3" >&2; exit 1; }
# Assert the baked LANGUAGE set is exactly eng+rus (Pitfall 4: no stray
# language packs leaked from the build stage) -- scoped to *.traineddata so
# the engine's own configs/ + tessconfigs/ output-format files (COPYd above,
# required for hocr/alto/tsv output) are allowed alongside them.
RUN [ "$(ls "${TESSDATA_PREFIX}"/*.traineddata | xargs -n1 basename | sort | tr '\n' ' ')" = "eng.traineddata rus.traineddata " ] \
 || { echo "FATAL: TESSDATA_PREFIX contains unexpected .traineddata files" >&2; exit 1; }
# Run unprivileged: the worker shells out to untrusted-input engines.
USER nobody
# The OCR engine invokes tesseract/pdftoppm/pdfinfo/pdftotext synchronously,
# one at a time per job (no forking daemon like LibreOffice's
# oosplash->soffice.bin), so -- matching Dockerfile.worker's/
# Dockerfile.av-worker's own documented rationale -- there is no orphaned-
# grandchild risk here and no init/reaper is needed as PID 1.
ENTRYPOINT ["/usr/local/bin/ocr-worker"]
