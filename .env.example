# Postgres (system of record)
DATABASE_URL=postgres://octo:octo-pass@localhost:5434/octo_db
DB_MAX_CONNS=10   # main-pool sizing (D-06a, Phase 58): must exceed INSPECT_MAX_CONCURRENT (default 4, Plan 58-06) with headroom for ordinary /v1/jobs traffic sharing the same pool -- default 10 = 4 (inspect) + 6 (everything else). Lowering this below INSPECT_MAX_CONCURRENT + a real margin reopens the pool-contention path a burst of POST /v1/inspect requests can exploit (each calls Repo.PreAdmit against this pool) -- see internal/db/db.go's Connect doc comment for the full arithmetic and what breaks if it's violated.

# Redis (asynq broker + hot progress)
REDIS_ADDR=localhost:6379

# S3 / MinIO
S3_ENDPOINT=localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=octoconv
S3_USE_SSL=false   # strict boolean: only "true"/"false" (optionally followed by an inline "#" comment) are accepted; any other value aborts API/worker startup with an explicit error

# API
API_ADDR=:8090
HEALTH_ADDR=:8091   # dedicated listener for GET /healthz (D-06/D-08, Phase 58): a burst against API_ADDR (in particular POST /v1/inspect) cannot take an accept-path resource away from the liveness probe's own listener. GET /healthz continues to answer on API_ADDR too, unchanged, for the e2e job (deploy/chart/octoconv/templates/job-e2e.yaml) and operator scripts (scripts/cancel-liveproof.sh, scripts/quota-burst-driver.sh) that already probe it there. The Helm chart's liveness/readinessProbe target THIS port, not API_ADDR (deployment-api.yaml).
# Worker protocol listener (D-02). Leave ALL seven unset and the client API
# still starts; the worker port stays closed. Set any one and the process
# refuses to start until the rest are set. There is no TLS-off flag.
# WORKER_FILE_ACCESS must be direct; gateway is refused. All seven must be
# set together. Local key files must be mode 0444 because the api image runs
# as nobody.
# WORKER_ADDR=:8443
# WORKER_TLS_CERT=/etc/octoconv/worker-tls/server.crt
# WORKER_TLS_KEY=/etc/octoconv/worker-tls/server.key
# WORKER_CLIENT_CA=/etc/octoconv/worker-tls/ca.pem
# WORKER_ORIGIN=worker.octoconv.local
# WORKER_MANIFEST_DIR=/etc/octoconv/worker-manifests
# WORKER_FILE_ACCESS=direct
MAX_UPLOAD_BYTES=2147483648   # 2 GiB -- D-07 (Phase 35, operator-confirmed 2026-07-21): raised from the prior 100 MiB so video uploads are admissible. This is a pre-parse http.MaxBytesReader bound, enforced BEFORE the engine class is known, so it alone cannot distinguish a legitimate 1 GiB video from a 1 GiB image. A SECOND, per-engine ceiling (internal/api's D-07 MaxEngineBytes, not env-configurable) runs immediately AFTER content-type detection and holds image/document/html/audio at their prior 100 MiB effective bound -- the raise here does not weaken their DoS posture, only the av engine class gains the larger allowance.
MAX_IMAGE_PIXELS=100000000   # decompression-bomb guard: max declared width*height (default 100 megapixels, e.g. 10000x10000)
MAX_DOCUMENT_UNCOMPRESSED_BYTES=524288000   # zip-bomb guard: max total declared uncompressed size summed across all ZIP entries in an office document (default 500 MiB)
API_KEY_SALT=change-me-to-a-long-random-secret   # server-side pepper for API-key hashing (required)
RATE_LIMIT_IP_RPM=60   # coarse pre-auth IP flood guard, requests/min
RATE_LIMIT_CLIENT_RPM=120   # per-client requests/min
OPERATOR_CLIENT_IDS=   # comma-separated client UUIDs authorized for /v1/system/presets; empty/unset = no operators, fail-closed; parsed once at API startup, restart to change (D-01/OPER-01)

# Synchronous inspect boundaries (58-CONTEXT.md D-06, Plan 58-06). All five
# values below are STARTING points for the live gate (Plan 58-08, SC6) to
# calibrate, not measured numbers -- copying a number from an unrelated
# engine class is this project's own documented anti-pattern (see
# AUDIO_ENGINE_TIMEOUT/OCR_ENGINE_TIMEOUT above for the measured-provenance
# precedent this phase deliberately does NOT yet have).
INSPECT_MAX_UPLOAD_BYTES=191889408   # 183 MiB pre-parse http.MaxBytesReader ceiling on POST /v1/inspect's BODY -- separate from and much smaller than MAX_UPLOAD_BYTES: inspect never writes to S3 or enqueues a job, so it has no reason to accept a multi-gigabyte body. Exceeding THIS is a 413 (request rejected).
INSPECT_MAX_WORK_BYTES=8388608   # 8 MiB byte ceiling on how much of the ALREADY-ACCEPTED upload every family analyzer may read in total (internal/inspect.Budget). Distinct from the ceiling above: this bounds what is READ, not what is ACCEPTED. Exhausting THIS marks the report partial/выборочный (INSP-03) -- it does NOT reject the request; the report is still returned, honestly labeled incomplete.
INSPECT_MAX_WORK_DURATION=2s   # wall-clock ceiling for the same operation (internal/inspect.Budget.MaxDuration) -- a courtesy outer bound, not the load-bearing mechanism: a context deadline alone cannot interrupt a CPU-bound parsing loop that never checks it (internal/inspect/budget.go's Tracker doc comment, 58-RESEARCH.md Q4).
INSPECT_MAX_CONCURRENT=4   # capacity of the semaphore bounding how many inspect requests may be parsing bytes at once (internal/api/inspectgate.go). MUST stay comfortably below DB_MAX_CONNS above (default 10 = 4 inspect + 6 headroom): the slot is held for the whole request, including its Repo.PreAdmit call, so concurrent PreAdmit calls against the shared pool are bounded by this exact number (D-06a) -- raising this without raising DB_MAX_CONNS to match reopens the pool-contention path Plan 58-03 closed.
RATE_LIMIT_INSPECT_RPM=30   # inspect's OWN per-client rate budget (D-06 mechanism 4), independent of RATE_LIMIT_CLIENT_RPM above -- lower because one inspect parse is materially more expensive than one status poll. CAVEAT (D-07): in-process, in-memory, exactly like internal/ratelimit's other limiters (see that package's own doc comment) -- while api.replicas stays at 1 (deploy/chart/octoconv/values.yaml) this is a real service-wide limit; the moment replicas > 1 this state stops being shared and the effective budget silently multiplies by the replica count, with no compile error or deploy warning. Upgrade path is httprate's WithLimitCounter backed by Redis.
JOBS_LIST_DEFAULT_PAGE_SIZE=20   # GET /v1/jobs page size when ?limit is absent/unparseable (D-06 tunable, Phase 40)
JOBS_LIST_MAX_PAGE_SIZE=100   # GET /v1/jobs ?limit clamp ceiling; requests above this clamp to it rather than 422 (D-06 tunable, Phase 40)
SSE_POLL_INTERVAL=1s   # GET /v1/jobs/{id}/events (PUSH-01, Phase 42): how often the handler re-reads the job row; emits a `progress` event only when status/progress_pct/eta_seconds changed since the last emit (D-01), and for a CAD job also when stage changes
SSE_HEARTBEAT_INTERVAL=15s   # PUSH-01: `: keepalive` comment cadence, so idle proxies don't time out an open stream (D-01)
SSE_MAX_STREAM_DURATION=30m   # PUSH-01: safety cap that closes a stream whose job never reaches a terminal status, so a wedged/abandoned stream can't hold a connection+goroutine forever (D-02)

# Protocol attempt budget for an image job (cmd/api). Default 120s.
ENGINE_TIMEOUT=120s

# Webhook worker (cmd/webhook-worker; Phase 16 — sole webhook-delivery consumer and sole sweeper host)
WEBHOOK_WORKER_CONCURRENCY=4   # asynq concurrency for cmd/webhook-worker; mirrors WORKER_CONCURRENCY's default
WEBHOOK_SIGNING_SECRET=change-me-to-a-long-random-secret   # HMAC-SHA256 secret for signed webhook callbacks (required for cmd/webhook-worker, which fails closed at startup if unset; also read, SAME secret, no rotation, by every worker cmd that sends progress webhooks: av, ocr, pandoc, probe, tectonic and cad; without it their progress webhooks are silently disabled)
WEBHOOK_PRESIGN_TTL=6h   # presigned download_url lifetime per webhook delivery attempt (optional, default 6h; webhook-worker-only)
# WEBHOOK_ALLOW_INSECURE_HTTP / WEBHOOK_ALLOW_PRIVATE_IPS are API-side only:
# enforced by validateCallbackURL in the api process at job-creation time, not
# read by cmd/webhook-worker. Both are parsed strictly (internal/envcfg): only
# "true"/"false" are recognized, an inline "#" comment IS tolerated (it does
# not defeat the flag), and any other value is rejected and warned about at
# API startup, leaving the fail-closed default in effect. This means a value
# like WEBHOOK_ALLOW_PRIVATE_IPS=true   # staging that was silently
# INEFFECTIVE before genuinely enables the flag now -- re-check any
# hand-edited deployment environment that relies on the old, lenient
# behavior.
WEBHOOK_ALLOW_INSECURE_HTTP=false   # opt-in: allow webhook callback_url to use http (non-https) scheme (default false)
WEBHOOK_ALLOW_PRIVATE_IPS=false   # opt-in: allow webhook callback_url to target RFC1918 private-IP addresses; loopback/link-local/unspecified remain hard-blocked regardless (default false, D-01/D-02)

# Document worker
DOCUMENT_WORKER_CONCURRENCY=1   # CONF-06/D-09 (phase 70): one task per container -- soffice's ruleset grants the shared /tmp read-write (SANDBOX-PATHS.md, 70-02), and a confined worker refuses to start above 1; scale with replicas, not in-process concurrency
DOCUMENT_ENGINE_TIMEOUT=300s   # Phase 9 D-01
DOCUMENT_MAX_RETRY=3   # bounded retry budget for document conversion, mirrors IMAGE_MAX_RETRY; also feeds the derived per-job uniqueness-lock TTL together with DOCUMENT_ENGINE_TIMEOUT
VERAPDF_TIMEOUT=60s   # own timeout for the bundled veraPDF CLI validation call, separate from DOCUMENT_ENGINE_TIMEOUT (Phase 23 D-04); well inside the 300s document engine budget

# DOCUMENT_SANDBOX_DISABLED is DELIBERATELY NOT SET HERE, for the same reason
# PROBE_SANDBOX_DISABLED/HTML_SANDBOX_DISABLED are not: unset means confined.
#
# cmd/document-worker runs soffice and veraPDF under two measured Landlock
# rulesets (docs/SANDBOX-PATHS.md, document section): the job
# directory writable, /dev/null, soffice allowed the container's shared /tmp
# read-write (its single-instance socket needs it; hence one task per
# container), and veraPDF writing nowhere else. Both engines get allowlisted
# environments, not this process's own.
#
# The worker REFUSES TO START if the sandbox is wanted and cannot be
# established -- including an image built for linux/amd64 and run emulated on
# an arm64 host, where Landlock is unavailable. Its preflight proves both
# engines succeed inside the job directory and are denied a file outside it,
# judged by CONTENT (soffice is silent when denied; veraPDF exits the same
# code for a verdict and a denial).
#
# Only the exact value "true" disables it.
# DOCUMENT_SANDBOX_DISABLED=true

# Protocol attempt budget for an html job (cmd/api). Default 60s.
HTML_ENGINE_TIMEOUT=60s

# Protocol attempt budget for an audio job (cmd/api). Default 742s.
AUDIO_ENGINE_TIMEOUT=742s

# Protocol attempt budget for an av job (cmd/api). Default 753s.
# RTF-FINALIZED by Phase 36 Plan 04's supervised scripts/av-rtf-measure.sh
# matrix run (D-05/AVE-04, 36-04-SUMMARY.md): N=10, threads=2, --cpus=2.0
# --memory=1g, arm64, pinned ffmpeg n8.1.2, production argv
# (transcodeToMP4Args/transcodeToWebMArgs). p95 RTF worst BOUNDED (enum,
# <=1080p) cell = hevc@1080 = 4.179133s -- NOT vp9 as 36-RESEARCH.md's D-09
# assumed; HEVC dominates VP9 by 1.86x (vp9@1080 p95=2.253267s). The
# hevc@2160p passthrough (no -vf scale) cell OOM-KILLED (exit 137) at this
# same 1g limit -- a real memory-safety DoS signal, not just slowness;
# closed via disposition (b) "bound the path" (see AV_MAX_DURATION_SECONDS
# below and internal/convert/av.go's enforceReencodeSourceBound), NOT by
# folding an unmeasurable fixture-sized number into this timeout. EVERY
# re-encode (stream-copy remux exempt) is bounded to a <=1920x1080 SOURCE
# envelope on both Height and Width (36-05 gap-closure, CR-01/HI-01,
# 36-REVIEW.md): re-encoding/downscaling FROM a source larger than 1080p is
# rejected fail-closed -- a NAMED capability limitation, not silently
# allowed, pending a future measured decode-then-downscale RTF envelope.
AV_ENGINE_TIMEOUT=753s   # ceil(90 x 4.179133 x 2.0) = 753s (16.3% margin under the 900s/15m reconciler CAP). Raising this toward 900s requires raising RECONCILER_ACTIVE_STALE_AFTER in the same change.

# Protocol attempt budget for an ocr job (cmd/api). Default 744s.
# MEASURED (Phase 45 Plan 03's supervised scripts/ocr-timing-measure.sh run,
# 45-03-SUMMARY.md): ALL GREEN on the real ocr-worker image at
# --cpus=2.0/--memory=1g (arch=arm64, N=10, omp_thread_limit=2, representative
# synthesized corpus -- see SUMMARY corpus-representativeness note). Per-cell
# p95 sec/page: clean_eng=3.010 clean_rus=2.927 dense_eng=5.810 dense_rus=5.789
# noisy_eng=3.646 noisy_rus=3.017 -- worst cell = dense_eng, p95=5.81 s/page.
# D-03's provisional OCR_MAX_PAGES=200 ceiling BREACHED the 900s/15m
# RECONCILER_ACTIVE_STALE_AFTER CAP (ceil(200 x 5.81 x 2.0)=2324s) -- Path-B
# NO-GO lever FIRED (mirrors AV_MAX_DURATION_SECONDS/AUDIO_MAX_DURATION_SECONDS
# precedent): OCR_MAX_PAGES lowered 200 -> 64. OCR_ENGINE_TIMEOUT =
# ceil(OCR_MAX_PAGES x worst-cell-p95-sec-per-page x 2.0 safety) =
# ceil(64 x 5.81 x 2.0) = 744s, 17.3% under the 900s CAP. NEVER copied from
# AV_ENGINE_TIMEOUT(753s)/AUDIO_ENGINE_TIMEOUT(742s) (PITFALLS.md Pitfall 7 --
# OCR's cost model is per-page, not per-input-duration, so a neighboring
# engine class's timeout is wrong-by-construction here; 744 is distinct from
# both). Raising this toward 900s requires raising RECONCILER_ACTIVE_STALE_AFTER
# in the same change.
OCR_ENGINE_TIMEOUT=744s

# Protocol attempt budget for a pandoc job (cmd/api). Default 65s.
# MEASURED (Phase 49 Plan 03's supervised scripts/pandoc-timing-measure.sh
# run, 49-03-SUMMARY.md, mirrors OCR_ENGINE_TIMEOUT's own
# provisional-fallback-then-measured provenance, 45-03-SUMMARY.md): ALL GREEN
# on the real pandoc-worker image at --cpus=2.0/--memory=1g (arch=arm64,
# N=10/cell, nearest-rank p95, wall-sec/conversion), measured AT the 4 MiB
# PANDOC_MAX_INPUT_BYTES cap below. Worst cell = html_large->md (reader-heavy
# HTML parsing), p95=32.318s (other large cells: md->html 25.37s, md->docx
# 23.34s, html->docx 15.99s, latex->html 6.06s, latex->docx 3.90s; all
# small/medium cells < 0.4s). PANDOC_ENGINE_TIMEOUT = ceil(worst_p95 x 2.0) =
# ceil(32.318 x 2.0) = 65s, 92.8% margin under the 900s/15m reconciler CAP.
# NO MAX_PAGES-style multiplier (unlike OCR) -- pandoc's p95 already IS the
# full per-conversion cost. NEVER copied from OCR(744s)/AV(753s)/AUDIO(742s)
# or the prior 90s placeholder (PITFALLS.md Pitfall 7) -- 65s is distinct
# from all four.
PANDOC_ENGINE_TIMEOUT=65s
PANDOC_MAX_INPUT_BYTES=3145728   # 3 MiB input-size DoS guard (enforcePandocInputSize, markupsniff.go). Path-B lever fired TWICE, both times on MEMORY not the 900s CAP: 50 MiB placeholder -> 4 MiB (49-03, zip-out targets OOM at 8 MiB input) -> 3 MiB (50-04, a live ~4.09 MB html->md OOMKilled the real worker container at the 1Gi limit). The cap also bounds a container's DECLARED UNCOMPRESSED size (x4), so a small-but-explosive docx/epub cannot slip past. Read by cmd/api as the pandoc per-engine upload ceiling (Config.MaxPandocInputBytes).

# Probe (sanitize, Phase 60). The eighth engine class
# and the only one that converts nothing -- it runs the sanitize operation:
# PDF/OOXML/image rebuilt with the enumerated classes of construct removed,
# then verified absent by an implementation that did not do the removing.
#
# PROBE_ENGINE_TIMEOUT is MEASURED (2026-09-02, scripts/probe-timeout-measure.sh;
# full output and derivation committed at
# .planning/phases/60-sanitize-eighth-engine-class/evidence/probe-timeout-20260902-measured.txt).
# Run in the measurement container at --cpus 2.0 --memory 1g against gs 10.00.0
# -- the version the worker image actually resolves to, NOT the host's 10.07.1
# -- on eleven files from 331 B to 2.2 MB, all sanitizing and verifying.
#
# WHAT THE COST DEPENDS ON: pages, not bytes. Three independent points give a
# dead-linear per-page cost for full-page scans -- 20 pages/39.738s,
# 100 pages/200.437s, 240 pages/481.308s, i.e. 1.99-2.01 s/page. A 219 KB
# document took 481s while a 2.2 MB one took 39.7s. A text page costs ~0.15s.
#
# WHY NOT p95: the script reports p95=200.437s and would recommend
# ceil(p95 x 3)=602s, but that number is an artifact of which files are in the
# corpus. When cost is set by page count and the corpus is chosen by hand, a
# wall-clock percentile measures the choice of corpus rather than the engine.
#
# DERIVATION -- the shape OCR already uses (per-unit cost x ceiling x margin),
# applied to this engine's own measurement:
#
#   PROBE_ENGINE_TIMEOUT = ceil(2.0 s/page x 200 pages x 1.5) = 600s
#
# 200 pages of full-page scans is a generous document bound. 600s sits 33%
# under the 900s RECONCILER_ACTIVE_STALE_AFTER cap, which at 2.0 s/page is an
# absolute ceiling of 450 pages that no timeout may exceed. NEVER copied from
# OCR(744s)/AV(753s)/AUDIO(742s)/PANDOC(65s) -- 600s is distinct from all four
# and derived, not picked (PITFALLS.md Pitfall 7).
#
# WHAT IT DOES NOT COVER, AND WHAT NOW DOES: a document beyond roughly 300
# pages of full-page scans hits this timeout. The page ceiling lives in the
# external probe worker.
#
# The API reads PROBE_ENGINE_TIMEOUT as the protocol attempt budget. It is
# not an input to queue.NewClient.
PROBE_ENGINE_TIMEOUT=600s   # measured -- see the derivation above

# Tectonic (tex engine class, latex -> pdf, Phase 64). The ninth class.
#
# TECTONIC_ENGINE_TIMEOUT is MEASURED (2026-09-04,
# scripts/tectonic-timeout-measure.sh; full output and the corpus's own
# provenance are committed under the phase's evidence/ and at
# internal/convert/testdata/tectonic/corpus/PROVENANCE.md).
#
# DERIVATION
#
#   TECTONIC_ENGINE_TIMEOUT = ceil(25.76 s/pass x 7 passes x 1.5) = 271s
#
#   25.76 s/pass  the per-pass cost measured on a 2 143 444-byte document
#                 (745 typeset pages, 180.3s at 7 passes) in the worker image at
#                 the chart's own 2 CPU / 1 GiB, with --network none and USER
#                 nobody. That document is 2.2% LARGER than the 2 097 152-byte
#                 input ceiling below, so the cost is taken on marginally more
#                 work than this service will admit -- conservative, and said
#                 out loud rather than rounded away. It is a measurement near
#                 the ceiling, never an extrapolation to it: the 100 MiB this
#                 engine first inherited was never run, because the point of a
#                 bound is that it is measured where it binds.
#   7 passes      the ENGINE's own rerun maximum, not a corpus statistic:
#                 tectonic reruns until its references converge and then stops,
#                 printing "TeX rerun seems needed, but stopping at 6 passes".
#                 Every bibliography document in the corpus hits it at every
#                 size, so the bound holds for any document.
#   x1.5          probe's margin, covering two named things: the 2.5% of the
#                 job that is outside the engine (S3 download + upload,
#                 measured through the live API on the same document -- 184.9s
#                 in-worker against 180.3s engine-only), and the gap between
#                 the measuring host and the deployment. OCR and pandoc needed
#                 x2.0 because their tails are open; this one's tail is closed
#                 by the pass ceiling.
#
# NOT a p95. With pass counts of 2, 3 and 7 for the same body text, a
# wall-clock percentile measures the corpus's mix of classes -- the same trap
# .env.example records for PROBE_ENGINE_TIMEOUT, and worse here, because pass
# count varies more than page count does.
#
# 271s is 70% under the 900s RECONCILER_ACTIVE_STALE_AFTER cap, so the
# reconciler can never treat a running tex job as abandoned.
#
# The API reads TECTONIC_ENGINE_TIMEOUT as the protocol attempt budget.
# It is not an input to queue.NewClient.
TECTONIC_ENGINE_TIMEOUT=271s   # measured -- see the derivation above
TECTONIC_ENGINE_CPU_SECONDS=271s   # what one document may COST, via RLIMIT_CPU on the engine. Same number as the wall deadline, and that is not a coincidence -- see below.
#
# CPU-SECONDS AND WALL CLOCK ARE DIFFERENT QUANTITIES, and only one of them is
# the document's fault. Measured in the shipped image at the chart's 2-CPU
# quota, the SAME document twice:
#
#   idle                      0.96s wall   0.95s CPU   cpu/wall = 1.00
#   node oversubscribed 4x    3.67s wall   1.08s CPU   cpu/wall = 0.28
#
# Wall clock inflated 4x while consumption did not move. So a bound on wall
# clock alone refuses documents for the sins of their neighbours: a document
# legitimately needing 180 CPU-seconds is killed at the 271s wall deadline on a
# busy node, and the client is told their file did not finish typesetting.
#
# Both bounds are kept, because they catch different things:
#
#   - the CPU budget catches a document that COSTS too much. Terminal: it costs
#     the same next time. Enforced by the kernel (RLIMIT_CPU, soft == hard, so
#     there is no grace period a runaway could spend running). The
#     kill arrives as SIGXCPU -- measured, after assuming SIGKILL and being
#     wrong -- and the classifier accepts either.
#   - the wall deadline still catches a process that is stuck rather than
#     working -- one that sleeps forever consumes no CPU at all.
#
# And when the wall deadline fires while the engine got less than HALF OF ONE
# CPU -- consumed CPU over elapsed engine time, NOT a fraction of the budget --
# that is classified as STARVATION and is RETRYABLE: the deadline said the
# attempt took too long, not that the document did.
#
# A share and not a fraction of the budget, deliberately: comparing against the
# budget made the verdict depend on the relationship between two independently
# adjustable settings. With a 600s budget and the 271s deadline, a runaway that
# saturates a CPU consumes ~271s -- under half of 600 -- and would have been
# called starvation and retried, multiplying its cost across every attempt. A
# share cannot be gamed that way: a document that had a CPU to itself is at
# 1.00 however the two are configured.
#
# WITH A UNIT, and at least 1s. A bare number is refused rather than ignored:
# "60" is a plausible way to write sixty seconds, and falling back to the
# default would hand you a bound four times weaker than the one you asked for,
# silently.
#
# AT LEAST 1s, and the worker REFUSES TO START below that. RLIMIT_CPU is
# expressed in whole seconds, so 0s, -1s and 500ms are all valid durations that
# truncate to a budget of zero -- at which point no limit is applied at all and
# the worker would log a bound it does not enforce. Refused rather than
# truncated, so an operator who asked for a bound gets a sentence instead of a
# service that quietly has none.
#
# TECTONIC_ENGINE_TIMEOUT is the protocol attempt budget. It is not an input
# to queue.NewClient.
TECTONIC_MAX_OUTPUT_BYTES=33554432   # 32 MiB, MEASURED at both ends -- see below. The external worker reads it.
# TECTONIC_SANDBOX_DISABLED is DELIBERATELY NOT SET HERE. Unset means the
# engine runs under a Landlock ruleset that grants the job directory, the
# bundle, the format cache and the system directories and nothing else; the
# worker exits at startup rather than typesetting client documents unconfined.
# "true" -- and only that exact string -- turns it off, for a kernel that has
# no Landlock. Every other value leaves the sandbox ON, because a
# half-recognised value read as "off" by an operator and "on" by the code is
# survivable and the reverse is not.
#
# TECTONIC_CACHE_DIR becomes REQUIRED once the sandbox is on, and the worker
# refuses to start without it. Unsandboxed, a tectonic that finds no cache
# falls back to $HOME/.cache and compiles its own format; under Landlock $HOME
# is not granted, so the same fallback ends as "cannot write format file
# texput.fmt: Permission denied" on EVERY job -- a message that names the
# sandbox rather than the unset variable. The image sets it; this note is for
# anyone who unsets it.
#
# It is also VALIDATED at startup, and every refusal below is one the worker
# will state in a sentence rather than discovering per job. The cache must:
#
#   - exist and be a directory, reachable through a symlink if you use one
#     (a versioned/mounted cache-current -> cache-2026-09 layout is fine);
#   - NOT be a system directory (/, /etc, /usr, /var, /home, ...) or the
#     worker's $HOME -- see below for why granting one is not survivable;
#   - NOT contain the directory jobs are materialised in (so not /tmp, and not
#     a relative path that resolves onto it -- TECTONIC_CACHE_DIR=tmp with the
#     image's working directory of "/" is the same thing as /tmp);
#   - hold at least one and at most 64 REGULAR *.fmt files. A symlink named
#     *.fmt does not count: the sandbox would grant whatever it points at.
#
# The reason all of this is startup-fatal rather than best-effort: Landlock
# grants are PATH BENEATH, so whatever is granted is granted along with
# everything under it. Granting /etc hands every client document /etc/passwd;
# granting /tmp hands one client every other client's files. The sandbox
# grants the format FILES themselves rather than the configured directory, so
# these checks are a second line -- but a misconfiguration that reaches them
# should be a sentence at boot, not a permission error on somebody's job.
#
# What it removes, measured on the shipped image through the live API: the SAME
# document (\openin=/etc/hostname, then \newpage if the read worked) came back
# as 1 page with the sandbox and 2 pages with TECTONIC_SANDBOX_DISABLED=true.
# --untrusted refuses \write18 and does NOT confine reads.
#
# THE OUTPUT CEILING, and why the input ceiling is not it. Found in review
# (PR #16, codex round 2, P1): the 2 MiB input bound is what the client is
# CHARGED for, and it says nothing about what comes back, because TeX ships
# pages out and frees the memory as it goes. Measured in the shipped image:
#
#   198 bytes of .tex     ->  6 040 163 bytes of PDF in 16 seconds
#   199 bytes, via the API -> 19 545 890 bytes of PDF in 93 seconds
#   2 143 444 bytes .tex  ->  1 914 057 bytes of PDF (745 pages, the real case)
#
# The second line is 10x the largest real document from an upload billed at 199
# bytes, in a third of the time available -- measured, not extrapolated, because
# these runs are not linear under the container's memory pressure (a 240 000-page
# variant produced FEWER bytes than a 130 000-page one). 32 MiB is 17x the
# largest legitimate document measured at the input ceiling, and the failure is terminal
# with its own code (output_too_large) rather than "could not be typeset" --
# nothing is wrong with the document, there is just too much of it.
#
# THE INPUT CEILING IS THE OTHER HALF OF THE TIMEOUT, and it is not an env var:
# it is api.defaultMaxEngineBytes[EngineTectonic] = 2 MiB. Stated here because
# the number above is meaningless without it.
#
# Cost is LINEAR in source size at a fixed 7-pass ceiling -- 1 071 659 bytes ->
# 373 pages -> 90.0s, 2 143 444 bytes -> 745 pages -> 180.3s -- so an unbounded
# input is an unbounded clock. At the 100 MiB this engine first inherited from the
# document-shaped engines, a dense .tex is roughly 36 000 pages and ~9000s: TEN
# TIMES the reconciler cap. The lever is a bound on the INPUT, which is the
# Path-B move OCR already made, never a smaller margin. Raising the ceiling
# without re-measuring the timeout breaks the pair in exactly the way
# PROBE_MAX_PAGES and PROBE_ENGINE_TIMEOUT would.
#
# TECTONIC_BUNDLE_PATH is deliberately NOT listed as an operator knob. The
# in-repo tex image is retired. The bundle is built in
# tileforge/octoconv-worker-tectonic. scripts/tectonic-bundle-fetch.sh still
# downloads the release asset this repository publishes.

# CAD (cad engine class, STEP/IGES/STL/DXF, Phases 73-76). The tenth class.
#
# CAD_ENGINE_TIMEOUT is MEASURED in the production worker: the longer route,
# each stage ceil(1.5 x W) over load-clean rows (host load1 <= 11), DERIVED in
# internal/convert/testdata/evidence/76-measured-bounds-keda-proof-client-docs/76-03-derived.txt
#
#   max(3D 21s guard + 324s mesh + 521s render + 20s I/O = 886s, DXF 661s) = 886s
#
#   21s guard   ceil(1.5 x 13.43 s), stress_wide
#   324s mesh   ceil(1.5 x 215.84 s), M2 (1518 assembly instances)
#   20s I/O     ceil(1.5 x 12.86 s), attempt wall minus stage walls (dxf_pdf)
#   521s render the remainder 886 - 21 - 324 - 20. 3D render cost is not bounded
#               by input bytes: a heavy assembly of any 3D format may be refused
#               at this deadline with cad_too_complex
#
# 886s is under the 900s stale-after window of the active-job reconciler, so it
# cannot treat a running cad job as abandoned. Every in-worker attempt wall
# x 1.5 is at most 886s (largest 586s, dxf_pdf). Measured on arm64 only.
#
# The input ceilings are the other half of the number: 63 MiB STEP, 120 MiB
# IGES (lowered from 135 MiB by the measured mesh memory), 182 MiB STL and
# 118 MiB DXF (internal/convert/cad.go), enforced at the API and in the worker.
# Every deployment's global MAX_UPLOAD_BYTES and INSPECT_MAX_UPLOAD_BYTES are
# above these ceilings plus the multipart framing, so they apply as stated.
#
# IN-02: read by every queue.NewClient()-constructing service for
# cadUniqueTTL's derivation. A value that reaches one process and not another
# does not error -- it produces duplicate processing, silently.
CAD_ENGINE_TIMEOUT=886s   # measured -- see evidence/76-03-derived.txt (phase 76)
CAD_MAX_RETRY=2   # bounded retry budget; an unreadable file, an over-complex model, an empty result and a mesh timeout are all TERMINAL. Retries remain for storage/infrastructure failures and for a node that cannot establish the sandbox.
CAD_WORKER_CONCURRENCY=1   # cad-worker-only, NOT read by queue.NewClient(). One model per 4 GiB cgroup; throughput comes from KEDA scale-out, not from raising this.
CAD_GUARD_TIMEOUT=21s   # cad-worker-only. The stdlib pre-pass that bounds entities and expanded instances before the CAD kernel sees the bytes. Measured (phase 76).
CAD_MESH_TIMEOUT=324s   # cad-worker-only. The meshing stage's own deadline, inside CAD_ENGINE_TIMEOUT. Measured (phase 76).
CAD_RENDER_TIMEOUT=521s   # cad-worker-only. The render stage's own deadline, inside CAD_ENGINE_TIMEOUT. The remainder of the measured 886s (phase 76); a heavy 3D assembly of any format may be refused at it with cad_too_complex.
#
# DXF (Phase 75): the drawing path runs guard -> cad-dxf -> rsvg-convert (the
# ink check) -> rsvg-convert (the PDF or PNG), so its stages sum separately
# from the 3D path and the worker refuses to start when either sum exceeds
# CAD_ENGINE_TIMEOUT:
#
#   21s guard + 186s cad-dxf + 2 x 217s rsvg-convert + 20s I/O = 661s <= 886s
#
#   186s cad-dxf  ceil(1.5 x 123.61 s), the slowest load-clean cad-dxf wall
#                 (row C, on record from the 0og run)
#   217s rsvg     ceil(1.5 x 144.54 s), the slowest load-clean rsvg-convert
#                 wall (PDF of L170030, in the worker)
#
# Both are DERIVED lines in
# internal/convert/testdata/evidence/76-measured-bounds-keda-proof-client-docs/76-03-derived.txt;
# the 118 MiB DXF ceiling is unchanged from 75-05-bounds.txt. The SVG output
# cap is 134 MiB and the PDF cap 19 MiB.
CAD_DXF_TIMEOUT=186s   # cad-worker-only. The cad-dxf drawing stage's own deadline, inside CAD_ENGINE_TIMEOUT. Measured (phase 76).
CAD_RSVG_TIMEOUT=217s   # cad-worker-only. The deadline of each rsvg-convert run of a drawing (the ink check, and the PDF or PNG), inside CAD_ENGINE_TIMEOUT. Measured (phase 76).
# CAD_SANDBOX_DISABLED is DELIBERATELY NOT SET HERE. Unset means the guard and
# the mesher each run under a Landlock ruleset granting the job directory and
# the measured read-only set and nothing else; the worker exits at startup
# rather than meshing client files unconfined. "true" -- and only that exact
# string -- turns it off, for a kernel that has no Landlock.

# Progress reporting (Phase 41 Plan 03, PROG-03). av-worker-only: the dual-gate
# throttle installed on the Handler via SetProgressThrottle, BEFORE
# srv.Start(mux) (cmd/av-worker/main.go), mirroring the AV_DISK_SAFETY_FACTOR
# wiring convention above. A progress write lands only when BOTH gates pass
# (>= this interval elapsed AND >= this pct delta since the last write); the
# terminal 100% write always bypasses both gates (D-03a). Starting defaults,
# not yet RTF-measured against a live transcode -- tune without a recompile.
PROGRESS_MIN_INTERVAL_SECONDS=2s   # Accepts bare integer seconds ("2") OR Go duration syntax ("2s"); an unparseable or negative value falls back to 2s (envDurationSeconds, cmd/av-worker/main.go).
PROGRESS_MIN_DELTA_PCT=1   # Minimum percent-complete movement since the last write required for a tick to land (envInt, cmd/av-worker/main.go).

# Progress webhook (Phase 42 Plan 03 — PUSH-02, D-04): a per-job opt-in,
# best-effort single-attempt inline delivery fired from the SAME throttle
# decision above -- explicitly NOT the terminal event's bounded-retry/
# dead-letter contract. Gated on WEBHOOK_SIGNING_SECRET being set;
# silently disabled (no progress webhooks fire, av-worker still starts)
# when unset.
PROGRESS_WEBHOOK_TIMEOUT=1500ms   # Per-attempt HTTP timeout for the detached inline progress-webhook fire (envDuration, cmd/av-worker/main.go). Deliberately SHORTER than PROGRESS_MIN_INTERVAL_SECONDS's 2s default so at most one detached fire is ever in flight per job.
# scripts/av-progress-liveproof.sh (Phase 41 Plan 04, PROG-05) is the
# operator-run live SIGKILL-mid-progress proof gate -- NOT part of the
# runtime service config above, and not required for `docker compose up`.
# It reads its OWN tunable env vars (all optional, AV_PROGRESS_LIVEPROOF_*
# prefix -- API base, fixture durations, goroutine-guard cycle count/
# tolerance) at invocation time only; see the script's own header comment
# for the full list and defaults. Run it against the live stack via:
#   docker compose up -d --build && bash scripts/av-progress-liveproof.sh

# Reconciler (webhook-worker-only as of Phase 16 — the sweeper runs solely in
# cmd/webhook-worker, lock-gated by a Postgres advisory lock so exactly one
# replica sweeps at a time; D-04)
RECONCILER_QUEUED_STALE_AFTER=90s   # lost-enqueue queued threshold (D-08)
RECONCILER_ACTIVE_STALE_AFTER=15m   # crashed-worker active threshold; raised from 5m (Phase 31, Pitfall 2 option 1) so it comfortably exceeds AUDIO_ENGINE_TIMEOUT's placeholder budget. This is a GLOBAL threshold (one column, all engine classes) -- raising it for audio also raises image/document/html staleness-detection latency (image/document were previously covered/exactly-covered at the old 5m default). Accepted deliberately: the enqueue-first + asynq.ErrDuplicateTask guard (proven by TestSweepSkipsDuplicateEnqueue) is the actual double-processing safety mechanism, not this threshold -- this value only controls how soon the reconciler *attempts* recovery. A per-engine override (Config shape change) was considered and deferred as a larger, more invasive refactor (STATE.md AudioUniqueTTL decision).
RECONCILER_SWEEP_INTERVAL=1m   # fixed sweep tick interval (D-10)
RECONCILER_MAX_RECOVERIES=3   # recovery cap before a job is marked reconciler_exhausted (D-12)

# Retention (RETN-01, Phase 51 Plan 04, D-11/D-12/D-13): a batched purge runs
# on the SAME reconciler tick as the sweep above, gated by the same
# advisory lock -- webhook-worker-only, no new deploy unit. Go durations
# have no day unit, so D-12's "90 days"/"400 days" are expressed in hours
# below (2160h = 90d, 9600h = 400d) -- writing "90d" here would silently
# fall back to the Go code default instead of erroring, which is exactly
# the kind of drift this project has been bitten by before (see the
# AV_ENGINE_TIMEOUT/OCR_ENGINE_TIMEOUT measured-value comments above for
# precedent on treating a silent env-parse fallback as a real defect
# class).
#
# To DISABLE a purge, set the variable to 0s. Leaving it unset or empty does
# NOT disable it: envDuration treats an empty value as absent and substitutes
# the positive 90-day/400-day code defaults, so the purge stays ON and aged
# data is deleted. The PurgeJobs/PurgeUsage <=0 guard in
# internal/jobs/retention.go (T-51-12) protects against a zero-valued
# reconciler.Config field -- it never sees the empty env var, because the
# default is substituted before the config is built.
JOBS_RETENTION=2160h   # 90 days: jobs/job_events/job_inputs/job_outputs/webhook_deliveries (cascade) purge window
USAGE_RETENTION=9600h   # 400 days: client_usage_daily purge window -- deliberately longer than JOBS_RETENTION so consumption history survives the jobs purge (D-01)
RETENTION_BATCH_SIZE=1000   # rows deleted per DELETE statement, bounding a single sweep tick's purge work (T-51-13)

# Storage lifecycle
STORAGE_TTL=168h   # single TTL for uploads/ and results/ prefixes, default 7 days; MinIO expiration is whole-day granular (D-10/D-11/D-12)

# Observability
METRICS_ADDR=127.0.0.1:9090   # localhost-only Prometheus /metrics listener, separate from API_ADDR; run api+worker on one host with distinct values (D-19)
METRICS_CLIENT_ID_CEILING=200   # caps distinct client_id label values admitted onto octoconv_client_job_outcomes_total (ACCT-04, D-08); deliberately NOT fanned out per-service like RECONCILER_*/engine-timeout vars above -- the admitted-label map is per-process by design (D-10), so a per-process difference here cannot corrupt anything, and the compiled default (200) already applies everywhere this var is left unset.

# Quota enforcement (QUOT-02/03/04, Phase 52)
QUOTA_ENFORCEMENT_DISABLED=false   # global kill-switch: "true" -- optionally followed by an inline "#" comment -- disables enforcement service-wide; empty/absent still does NOT disable it; any other value is rejected as unrecognized, warned about at API startup, and leaves enforcement ON -- per-client rollout stays governed by `manage-clients set-mode <id> observe|enforce` (new clients default to observe). Verdicts are still computed and counted via octoconv_quota_would_reject_total even while this is true (D-13/D-14).
