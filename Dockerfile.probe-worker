# Build stage
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/probe-worker ./cmd/probe-worker

# Runtime stage: the sanitize pipeline needs three external tools, and every
# one of them is load-bearing rather than convenient.
#
#   ghostscript  -- the two-pass PDF rebuild (ps2write then pdfwrite). Without
#                   it every PDF sanitize fails.
#   unzip        -- enumerates and extracts OOXML parts for verification. It is
#                   deliberately NOT our own archive/zip: SANI-04 requires the
#                   implementation that checks to differ from the one that
#                   removed, and the OOXML sanitizer is written on archive/zip.
#   file         -- libmagic, a third codebase again, classifies each extracted
#                   part by content so an OLE container is caught under any
#                   name.
#
# Missing any of them does not degrade the service, it stops it: verification
# cannot be skipped, and an output that cannot be verified is discarded rather
# than delivered (D-07). That is the correct behaviour and it is why these are
# installed here rather than treated as optional extras.
#
# NO exiftool, and NO oletools. Plan 60-03 chose a structural metadata strip
# over exiftool, so no image tool is needed at all; Plan 60-04 measured
# olevba against the corpus and found it reports "macros": [] on a package
# containing an OLE-signature part, which makes it the wrong verifier
# regardless of its merits as an analyser. Neither is a dependency this image
# carries "just in case".
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      tini \
      ghostscript \
      unzip \
      file \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/probe-worker /usr/local/bin/probe-worker

# Record what actually landed. The measured timeout is only meaningful against
# a known ghostscript, and `apt-get install ghostscript` on bookworm resolves
# to whatever the suite currently ships -- so the version is printed at build
# time into the build log rather than assumed from the Dockerfile.
RUN gs --version && file --version | head -1 && unzip -v | head -1

# Run unprivileged: this worker parses untrusted input in three different
# parsers, one of them (pdfcpu) inside its own address space.
USER nobody

# tini is PID 1 so orphaned grandchildren get reaped after a group SIGKILL.
# ghostscript forks, and internal/convert/exec.go kills the whole process
# group on timeout -- without a reaper those killed children reparent to PID 1
# and are never waited on. This is the same failure the document-worker image
# confirmed live in Phase 09 with LibreOffice's soffice.bin.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/probe-worker"]
